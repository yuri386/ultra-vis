<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 450" width="800" height="450">
  <defs>
    <linearGradient id="grad4" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#d32f2f;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#b71c1c;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="450" fill="url(#grad4)"/>
  <rect x="80" y="80" width="640" height="290" fill="white" opacity="0.1" rx="15" stroke="white" stroke-width="2"/>
  <text x="400" y="150" font-size="32" font-weight="bold" fill="#ffeb3b" text-anchor="middle" font-family="Arial">История науки</text>
  <text x="400" y="200" font-size="24" fill="white" text-anchor="middle" font-family="Arial">Основана в 1724 году</text>
  <text x="400" y="330" font-size="20" fill="white" text-anchor="middle" font-family="Arial">Лучшие традиции русского образования</text>
