<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="400" height="300">
  <defs>
    <linearGradient id="mathGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#7e57c2;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#5e35b1;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#mathGrad)"/>
  <g transform="translate(50, 50) scale(2)">
    <text x="0" y="0" font-size="36" font-weight="bold" fill="white" font-family="Arial">∑</text>
    <text x="50" y="20" font-size="28" fill="#ffeb3b" font-family="Arial">π</text>
    <text x="100" y="10" font-size="32" fill="white" font-family="Arial">∫</text>
  </g>
  <text x="200" y="280" font-size="20" font-weight="bold" fill="white" text-anchor="middle" font-family="Arial">Линейная алгебра</text>
</svg>