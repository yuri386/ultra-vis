<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="400" height="300">
  <defs>
    <linearGradient id="engGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1e40af;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1e3a8a;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#engGrad)"/>
  <rect x="60" y="80" width="280" height="120" fill="white" opacity="0.1" rx="10"/>
  <text x="200" y="130" font-size="32" font-weight="bold" fill="white" text-anchor="middle" font-family="Arial">English</text>
  <text x="200" y="165" font-size="16" fill="#ffeb3b" text-anchor="middle" font-family="Arial">Business English</text>
  <text x="200" y="270" font-size="18" font-weight="bold" fill="white" text-anchor="middle" font-family="Arial">Деловой английский</text>
</svg>