<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="400" height="300">
  <defs>
    <linearGradient id="historyGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#6f2da8;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#4a148c;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#historyGrad)"/>
  <g transform="translate(60, 60)">
    <rect x="0" y="0" width="40" height="120" fill="white" opacity="0.3" rx="3"/>
    <rect x="60" y="20" width="40" height="100" fill="white" opacity="0.5" rx="3"/>
    <rect x="120" y="10" width="40" height="110" fill="white" opacity="0.7" rx="3"/>
    <rect x="180" y="40" width="40" height="80" fill="white" opacity="0.9" rx="3"/>
  </g>
  <text x="200" y="270" font-size="20" font-weight="bold" fill="white" text-anchor="middle" font-family="Arial">История России: XIX век</text>
</svg>