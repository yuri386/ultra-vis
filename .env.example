PORT=8000
NODE_ENV=development
APP_URL=http://localhost:8000
SKILLLAND_URL=https://skillland-platform-yuri386.onrender.com

# Generate two different, long random values. In Render set the same
# ULTRAVIS_SSO_SECRET in both the SkillLand and Ultra VIS services.
JWT_SECRET=replace-with-a-long-random-value
ULTRAVIS_SSO_SECRET=replace-with-the-shared-long-random-value

# Optional local folder for the SQLite database. Render sets this automatically.
ULTRAVIS_DATA_DIR=
